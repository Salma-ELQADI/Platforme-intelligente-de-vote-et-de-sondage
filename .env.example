# Optional overrides for `docker compose up` (copy to .env at the repo root).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Needed only for AI poll generation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Set to false to skip demo accounts/polls.
SEED_DEMO=true
# Host port for the web app (change if 3000 is already used).
FRONTEND_PORT=3000
