# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (the Next.js frontend)
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

# ---------- PostgreSQL ----------
# Matches docker-compose.yml at the repository root
DATABASE_URL=postgres://votelive:votelive@localhost:5432/votelive

# ---------- Authentication ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# ---------- OpenRouter (server-side only, NEVER expose to the frontend) ----------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=20000

# ---------- Poll closure scheduler ----------
POLL_CLOSER_INTERVAL_MS=5000
